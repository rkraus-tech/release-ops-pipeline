# Normalize line endings by default
* text=auto

# Linux-side files must always use LF
*.sh        text eol=lf
Jenkinsfile text eol=lf
*.groovy    text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.service   text eol=lf

# Windows-side files
*.ps1       text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.gz  binary
